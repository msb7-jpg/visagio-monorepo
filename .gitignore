# ==============================================================================
# CineRocket Monorepo .gitignore
# ==============================================================================

# OS & Editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node / Frontend
node_modules/
dist/
.fallow/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun.lockb

# Local environment secrets & temporary databases
.env
*.local
*.db-shm
*.db-wal
*.db-journal

# Data Files & Archives
# Ignore uncompressed CSVs and full tar archives; preserve chunked parts for git
data/**/*.csv
data/data.tar.xz
!data/data.tar.xz.part-*

